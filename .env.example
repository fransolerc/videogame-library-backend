# Copia este archivo a .env y rellena los valores reales.
# .env NUNCA debe comitearse -- ya esta (o debe estar) en .gitignore.

# Credenciales de https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=your_twitch_client_id
IGDB_CLIENT_SECRET=your_twitch_client_secret

# Genera con: openssl rand -base64 64
JWT_SECRET=your_base64_jwt_secret

# Opcional -- valores por defecto ya definidos en application.yml si se omiten
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5173
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
